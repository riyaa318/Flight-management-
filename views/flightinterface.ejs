<style>
  .maincontainer {
    background: rgb(3, 7, 63);
    height: 100vh;
    width: 100vw;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 20px;
  }
  .box {
    width: 65%;
    height: 65%;
    background: whitesmoke;
    border-radius: 10px;
    padding: 15px;
  }
  .heading {
    font-size: 35px;
    letter-spacing: 1px;
    font-weight: bold;
    color: rgb(0, 15, 131);
    display: flex;
    flex-direction: row;
    font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
  }
  .daysstyle{
    display: flex;
    flex-direction: row;
    justify-content: space-evenly;
  }
</style>
<html>
  <head>
    <title>Flight Interface</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"/>
      <script src="https://code.jquery.com/jquery-3.6.1.min.js"></script>
      <script src="/javascripts/project.js"></script>
   </head>
    <div class="maincontainer">
      <div class="box">
        <div class="heading">
          <a href="/flight/dsiplayallflights"><img src="/images/display.png" width="30"></a>
          <img src="/images/flighticon.png" width="90" height="50" />
           Flight Interface
            </div>
          <form action="/flight/flightsubmit" method="post" enctype="multipart/form-data" class="row g-3">
            <div class="col-md-6">
              <label for="flightname" class="form-label"><b>Flight Name</b></label>
              <input type="text" class="form-control" id="flightname" name="flightname" />
            </div>
            <div class="col-md-6">
              <label for="flighttype" class="form-label"><b>Flight Type</b></label>
              <select id="flighttype" name="flighttype" class="form-select">
                <option selected>Choose Type...</option>
                <option>Economy Class</option>
                <option>Business Class</option>
              </select>
            </div>
            <div class="col-md-6">
              <label for="noofseats" class="form-check-label"><b>Total Seats</b></label>
              <input type="text" class="form-control" id="noofseats" name="noofseats" />
            </div>
            <div class="col-md-6 ">
              <label for="days" class="form-check-label"><b>Select Flight Days</b></label> 
              <div class="col-md-8 daysstyle">
            <span class="form-check">
              <input class="form-check-input" type="checkbox" value="Mon" name="days" id="days">
              <label class="form-check-label" for="days">
                Mon
              </label>
            </span>
             <span class="form-check">
              <input class="form-check-input" type="checkbox" value="Tue" name="days" id="days">
              <label class="form-check-label" for="days">
                Tue
              </label>
            </span>
             <span class="form-check">
              <input class="form-check-input" type="checkbox" name="days" value="Wed" id="days">
              <label class="form-check-label" for="days">
                Wed
              </label>
            </span>
             <span class="form-check">
              <input class="form-check-input" type="checkbox" name="days" value="Thu" id="days">
              <label class="form-check-label" for="days">
                Thu
              </label>
            </span>
             <span class="form-check">
              <input class="form-check-input" type="checkbox"name="days" value="Fri" id="days">
              <label class="form-check-label" for="days">
                Fri
              </label>
            </span>
             <span class="form-check">
              <input class="form-check-input" type="checkbox" name="days" value="Sat" id="days">
              <label class="form-check-label" for="days">
                Sat
              </label>
            </span>
             <span class="form-check">
              <input class="form-check-input" type="checkbox" name="days"value="Sun" id="days">
              <label class="form-check-label" for="days">
                Sun
              </label>
            </span>
            </div>
            </div>
            <div class="col-md-3">
              <label for="source" class="form-label"><b>Source City</b></label>
              <select id="source" name="sourcecity" class="form-select">
                <option selected>Source City</option>
              </select>
            </div>
            <div class="col-md-3">
              <label for="deptime" class="form-label"><b>Departure Time</b></label>
              <input type="time" class="form-control" id="deptime" name="deptime" />
            </div>
            <div class="col-md-3">
              <label for="destination" class="form-label"><b>Destination City</b></label>
              <select id="destination" name="destinationcity" class="form-select">
                <option selected>Destination City</option>
              </select>
            </div>
            <div class="col-md-3">
              <label for="arrtime" class="form-label"><b>Arrival Time</b></label>
              <input type="time" class="form-control" id="arrtime" name="arrtime" />
            </div>
            <div class="col-md-6">
              <label for="company" class="form-check-label"><b>Company</b></label>
              <input type="text" class="form-control" id="company" name="company" />
            </div>
          <div class="col-md-6">
            <label for="logo" class="form-check-label"><b>Logo</b></label>
            <input type="file" class="form-control" id="logo" name="logo" />
          </div>
          <div class="col-md-6">
            <button type="submit" class="btn btn-secondary">Submit</button>
          </div>
          <div class="col-md-6">
            <button type="reset" class="btn btn-secondary">Reset</button>
          </div>
        </div>
      </div>
      <!-- <div class="col-md-12" style="display: flex; justify-content: center; padding: 5px; font-weight: bolder;">
        <%= message %>
      </div> -->
</form>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"></script>
</html>
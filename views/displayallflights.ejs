<style>
    .maincontainer {
      background: rgb(63, 0, 140);
      height: 100vh;
      width: 100vw;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 20px;
    }
    .box {
      width: 65%;
      height: 65%;
      background: whitesmoke;
      border-radius: 10px;
      padding: 15px;
    }
    .heading {
      font-size: 35px;
      letter-spacing: 1px;
      font-weight: bold;
      color: rgb(0, 15, 131);
      display: flex;
      flex-direction: row;
      font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    }
    .daysstyle{
      display: flex;
      flex-direction: row;
      justify-content: space-evenly;
    }
  </style>
  <html>
    <head>
      <title>Flight Interface</title>
      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous"/>
    </head>
    <body>
        <div class="maincontainer">
            <div class="box">
              <div class="heading">
                <a href="/flight/dsiplayallflights"> <img src="/images/addrecord.png" width="30"></a>

              </div>
        <table class="table table-hover">
            <thead>
              <tr>
                <th scope="col">Fight Name</th>
                <th scope="col">Days/ <br>Seats</th>
                <th scope="col">Source City</th>
                <th scope="col">Destination City</th>
                <th scope="col">Company</th>
                <th scope="col">Logo</th>
                <th scope="col">Edit/Delete</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <% data.map((item)=> { %>
                <th scope="row"><%= item.flightname %>
                    <br>
                    <%= item.types %>
                </th>
                <td>
                   Seats: <%=item.totalseats %>
                    <br>
                    <%=item.days %>
                </td>
                <td>
                    <%=item.source  %>
                    <br>
                    <%=item.departuretime  %>
                </td>
                <td>
                    <%=item.destination  %>                   
                    <br>
                    <%=item.arrivaltime  %>
                </td>
                <td>
                    <%=item.company %>
                </td>
                <td>
                 <a href="/flight/searchbyidforimage?fid=<%=item.flightid%>"><img src="/images/<%=item.logo%>" width="30"/> </a> 
                </td>
                <td>
                  <a href="/flight/searchbyid?fid=<%=item.flightid%>">
                    Edit/Delete 
                  </a>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          </div>
          </div>
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
crossorigin="anonymous"></script>
</html>